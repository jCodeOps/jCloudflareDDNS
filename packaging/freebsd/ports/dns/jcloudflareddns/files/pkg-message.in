[
{ type: install
  message: <<EOM
jCloudflareDDNS is installed as a one-shot CLI. Its optional rc.d supervisor is
disabled by default.

Review %%ETCDIR%%/config.yml and add the corresponding API Tokens to
%%ETCDIR%%/tokens.env. Keep both files owned by root:jcloudflareddns; the token
file must have mode 0640 or stricter.

Validate the configuration before enabling automatic updates:

  jcloudflareddns validate --config %%ETCDIR%%/config.yml --all
  sysrc jcloudflareddns_enable=YES

The default interval is 300 seconds. Override it with jcloudflareddns_interval
in rc.conf; accepted values are 60 through 31536000 seconds. Service output is
sent to syslog with the jcloudflareddns tag.
EOM
}
{ type: upgrade
  maximum_version: "0.1.1"
  message: <<EOM
Version 0.1.1 adds an optional service account. Existing operator files retain
their ownership during the upgrade. Grant the account read access before
enabling the service:

  chown root:jcloudflareddns %%ETCDIR%%/config.yml %%ETCDIR%%/tokens.env
  chmod 0640 %%ETCDIR%%/config.yml %%ETCDIR%%/tokens.env
EOM
}
]
